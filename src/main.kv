#:kivy 2.3.1

<MainMenuScreen>:
    RelativeLayout:
        canvas.before:
            Color:
                rgba: 0.04, 0.06, 0.17, 1  # Deep Cosmic Blue default (#0A0F2C)
            Rectangle:
                pos: self.pos
                size: self.size
        # 2. FIXED GAP VIEWPORT: Pulls down the top anchor boundary
        ScrollView:
            size_hint: (1, 0.88)
            pos_hint: {'x': 0, 'y': 0}
            do_scroll_x: False       
            do_scroll_y: True        
            bar_width: dp(4)         
            scroll_type: ['content', 'bars']

            # MASTER VERTICAL CONTAINER
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(12), dp(12), dp(12), dp(24)]
                spacing: dp(15)

                # ==========================================
                # SYSTEM / MENU CONTROLS
                # ==========================================
                GridLayout:
                    cols: 3
                    spacing: dp(6)
                    size_hint_y: None
                    height: self.minimum_height

                    #DummyTile:
                    
                    BoxLayout: # About Screen Launcher
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: about_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'about'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'about_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.75, 1, 1 
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)
                    
                    BoxLayout: # Achievements Screen
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: achievements_screen_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'achievements_screen'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'achievements_screen_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.75, 1, 1 
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                    BoxLayout: # Settings launch tile
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: settings_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'settings'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'settings_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.75, 1, 1 
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                # ==========================================
                # MEMORY & ATTENTION
                # ==========================================
                Label:
                    text: "MEMORY & ATTENTION"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '16sp'
                    color: (0, 0.75, 1, 1)
                    size_hint_y: None
                    height: dp(20)
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'

                GridLayout:
                    cols: 3
                    spacing: dp(6)
                    size_hint_y: None
                    height: self.minimum_height

                    BoxLayout: # Focus Flash
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: focus_flash_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'focus_flash'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'focus_flash_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.75, 1, 1 
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                    BoxLayout: # Matrix Recall
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: matrix_recall_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'matrix_recall'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'matrix_recall_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.75, 1, 1 
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                    BoxLayout: # Planet Hopper
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: planet_hopper_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'planet_hopper'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'planet_hopper_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.75, 1, 1 
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                # ==========================================
                # SPEED
                # ==========================================

                                    size: self.size
                                Color:
                                    rgba: 0, 0.75, 1, 1 
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                # ==========================================
                # WIND DOWN
                # ==========================================
                Label:
                    text: "WIND DOWN"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '16sp'
                    color: (0, 0.85, 0.4, 1) # Gentle Green
                    size_hint_y: None
                    height: dp(20)
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'

                GridLayout:
                    cols: 3
                    spacing: dp(6)
                    size_hint_y: None
                    height: self.minimum_height

                    # 🟢 NEW: Zen Breathing Launch Tile
                    BoxLayout:
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: zen_breathing_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'zen_breathing'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    # Fallback to an existing preview image or create a new one
                                    source: app.active_atlas_prefix + 'zen_breathing_preview' 
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.85, 0.4, 1  # Gentle Green Border
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                    # 🟢 Screenshot Launch Tile
                    BoxLayout:
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: screenshot_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'screenshot'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'screenshot_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.85, 0.4, 1
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                    BoxLayout:
                        size_hint_y: None
                        height: self.width
                        Button:
                            id: linefill_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'linefill'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'linefill_preview'
                                    pos: self.pos
                                    size: self.size
                                Color:
                                    rgba: 0, 0.85, 0.4, 1
                                Line:
                                    rectangle: (self.x, self.y, self.width, self.height)
                                    width: dp(2)

                Widget:
                    size_hint_y: None
                    height: dp(10)

        BoxLayout:
            id: header_banner_bg
            orientation: 'vertical'
            size_hint_y: None
            height: dp(60)
            pos_hint: {'top': 1.0}
            
            canvas.before:
                Color:
                    rgba: 0.04, 0.06, 0.17, 1  # Banner Background Rect
                Rectangle:
                    pos: self.pos
                    size: self.size
                    
                Color:
                    id: header_banner_line_color
                    rgba: 0, 0.75, 1, 1  # Default Cyan Divider Line
                Line:
                    points: [self.x, self.y, self.x + self.width, self.y]
                    width: dp(2)

            Label:
                id: jbrcade_title_label
                text: "JBRCADE"
                font_name: "assets/fonts/ARCADE_N.TTF"
                font_size: '40sp'
                color: 0, 0.75, 1, 1

# 🟢 FIXED: Updated Placeholder tiles to display a stylized "COMING SOON!" container text box
<DummyTile@RelativeLayout>:
    size_hint_y: None
    height: self.width 
    canvas.before:
        Color:
            rgba: 0, 0.75, 1, 0.15 
        Rectangle:
            pos: (0, 0)
            size: self.size
        Color:
            rgba: 0, 0.75, 1, 0.4
        Line:
            rectangle: (0, 0, self.width, self.height)
            width: dp(1)
    Label:
        text: "COMING\nSOON!"
        font_name: "assets/fonts/ARCADE_N.TTF"
        font_size: '16sp'
        color: (0, 0.75, 1, 0.6)
        halign: 'center'
        valign: 'middle'
        center_x: root.width / 12
        center_y: root.height / 12

<SettingsScreen>:
    RelativeLayout:
        canvas.before:
            Color:
                rgba: 0.04, 0.06, 0.17, 1  # 🟢 Restored Deep Blue (#0A0F2C)
            Rectangle:
                pos: self.pos
                size: self.size

        # Pinned Header Title
        Label:
            text: "SETTINGS"
            font_name: "assets/fonts/ARCADE_N.TTF"
            font_size: '22sp'
            color: (0, 0.75, 1, 1)
            pos_hint: {'center_x': 0.5, 'top': 0.96}
            size_hint: (1, 0.08)

        # Back to Main Menu Button
        Button:
            text: "< MENU"
            font_name: "assets/fonts/ARCADE_N.TTF"
            font_size: '10sp'
            color: (1, 1, 1, 1)
            size_hint: (0.25, 0.05)
            pos_hint: {'x': 0.0, 'top': 1.0}
            background_normal: ''
            background_color: (0.8, 0.25, 0.25, 1)
            on_release: root.manager.current = 'menu'

        # ScrollView wrapping single vertical container
        ScrollView:
            size_hint: (0.9, 0.82)
            pos_hint: {'center_x': 0.5, 'top': 0.86}
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [0, dp(10), 0, dp(20)]
                spacing: dp(15)

                # 🟢 RESTORED VOLUME LAYOUT (Volume % \n [-] [+] \n Mute)
                Label:
                    id: vol_label
                    text: "VOLUME: 25%"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '12sp'
                    color: (1, 1, 1, 1)
                    size_hint_y: None
                    height: dp(25)

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(15)
                    size_hint_y: None
                    height: dp(45)

                    Button:
                        text: "-"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '16sp'
                        background_normal: ''
                        background_color: (0, 0.5, 0.8, 1)
                        on_release: root.adjust_volume(-0.05)

                    Button:
                        text: "+"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '16sp'
                        background_normal: ''
                        background_color: (0, 0.5, 0.8, 1)
                        on_release: root.adjust_volume(0.05)

                Button:
                    id: mute_btn
                    text: "MUTE AUDIO"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '12sp'
                    size_hint_y: None
                    height: dp(45)
                    background_normal: ''
                    background_color: (0.8, 0.2, 0.2, 1)
                    on_release: root.toggle_mute_state()

                # --- MUSIC TRACK SECTION ---
                Label:
                    text: "BACKGROUND MUSIC"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '12sp'
                    color: (0, 0.75, 1, 1)
                    size_hint_y: None
                    height: dp(25)

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(45)

                    Button:
                        text: "<"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '12sp'
                        size_hint_x: 0.2
                        background_normal: ''
                        background_color: (0, 0.75, 1, 0.3)
                        color: (0, 0.75, 1, 1)
                        on_release: root.cycle_music(-1)

                    Label:
                        id: music_label
                        text: "CLASSIC"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '12sp'
                        color: (1, 1, 1, 1)

                    Button:
                        text: ">"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '12sp'
                        size_hint_x: 0.2
                        background_normal: ''
                        background_color: (0, 0.75, 1, 0.3)
                        color: (0, 0.75, 1, 1)
                        on_release: root.cycle_music(1)

                # --- HAPTICS SECTION ---
                Button:
                    id: haptic_btn
                    text: "HAPTICS: ON"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '12sp'
                    size_hint_y: None
                    height: dp(45)
                    background_normal: ''
                    background_color: (0.1, 0.6, 0.3, 1)
                    on_release: root.toggle_haptics_state()

                # --- DATA RESET SECTION ---
                Button:
                    id: reset_btn
                    text: "RESET SAVE DATA"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '12sp'
                    size_hint_y: None
                    height: dp(45)
                    background_normal: ''
                    background_color: (0.8, 0.2, 0.2, 1)
                    on_release: root.reset_save_data()

                # --- COLOR BLINDNESS SECTION ---
                Label:
                    text: "COLOR BLINDNESS"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '12sp'
                    color: (0, 0.75, 1, 1)
                    size_hint_y: None
                    height: dp(25)

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(45)

                    Button:
                        text: "<"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '12sp'
                        size_hint_x: 0.2
                        background_normal: ''
                        background_color: (0, 0.75, 1, 0.3)
                        color: (0, 0.75, 1, 1)
                        on_release: root.cycle_color_blindness(-1)

                    Label:
                        id: cb_label
                        text: "NONE"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '12sp'
                        color: (1, 1, 1, 1)

                    Button:
                        text: ">"
                        font_name: "assets/fonts/ARCADE_N.TTF"
                        font_size: '12sp'
                        size_hint_x: 0.2
                        background_normal: ''
                        background_color: (0, 0.75, 1, 0.3)
                        color: (0, 0.75, 1, 1)
                        on_release: root.cycle_color_blindness(1)

<AboutScreen>:
    RelativeLayout:
        canvas.before:
            Color:
                rgba: 0.04, 0.06, 0.17, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: "ABOUT JBRCADE"
            font_name: "assets/fonts/ARCADE_N.TTF"
            font_size: '16sp'
            color: (0, 0.75, 1, 1)
            pos_hint: {'center_x': 0.5, 'center_y': 0.88}

        ScrollView:
            size_hint: (0.85, 0.60)
            pos_hint: {'center_x': 0.5, 'center_y': 0.50}
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(20)
                padding: [0, dp(10), 0, dp(10)]

                # Main About Message
                Label:
                    text: "Welcome to JBRCADE!\n\nWhat started as a selfish project has very quickly become a passion project that I would love to see in the hands of others. As someone who is frequently on the move and, more often than not, without internet access, I have been on a long quest to find something that is not only offline but also free and engaging. After being hit with many paywalls and pop-up ads, I finally concluded that if I wanted this, I would have to make it myself. And so, here I am.\n\nI cannot promise you will experience growth in your recall, reaction speed, or problem-solving. What I can promise you is a simple, compact collection of mini-games that will keep you busy when nothing else demands your attention. As someone always seeking a challenge and a chance to sharpen their mental edge, I have found great pleasure in building this project and putting it to the test. My only hope is that you will find this pleasure too.\n\nMuch love\nJBR"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '10sp'
                    color: (1, 1, 1, 1)
                    line_height: 1.35
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: (self.width, None)
                    halign: 'center'
                    valign: 'top'

                # Divider Line Accent
                Widget:
                    size_hint_y: None
                    height: dp(2)
                    canvas:
                        Color:
                            rgba: (0, 0.75, 1, 0.5)
                        Rectangle:
                            pos: self.pos
                            size: self.size

                # Credits Header
                Label:
                    text: "CREDITS & ACKNOWLEDGMENTS"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '11sp'
                    color: (0, 0.75, 1, 1)
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: (self.width, None)
                    halign: 'center'

                # Credits Details Text
                Label:
                    text: "*AUDIO & MUSIC\n\n CLASSIC: https://youtu.be/l7SwiFWOQqM?si=JagYeBTePhJBawRA \nCHILL: https://youtu.be/iGveRcDct6Q?si=4f0_uC_tRa_0Yjor \n HARDCORE: https://youtu.be/bXf0Sdvyb-w?si=wGmH4aCb1eqzU8R0 \n HALLOWEEN: https://youtu.be/Un_UZO2Bslk?si=08QWVqjqfkGS6NN2 \n CHRISTMAS: https://www.silvermansound.com/free-music/festv-frlix \n\n *Arcade retro Typography: \n\n ARCADE_N.TTF"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '8sp'
                    color: (0.7, 0.85, 1, 1)
                    line_height: 1.35
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: (self.width, None)
                    halign: 'center'
                    valign: 'top'

        Button:
            text: "< MENU"
            font_name: "assets/fonts/ARCADE_N.TTF"
            font_size: '9sp'
            size_hint: (0.65, 0.06)
            pos_hint: {'center_x': 0.5, 'center_y': 0.12}
            background_normal: ''
            background_color: (0.8, 0.25, 0.25, 1)
            on_release: root.manager.current = 'menu'
                            id: stroop_match_preview_button
                            background_normal: ''
                            background_color: 0, 0, 0, 0 
                            on_release: root.manager.current = 'stroop_match'
                            canvas.before:
                                Color:
                                    rgba: 1, 1, 1, 1
                                Rectangle:
                                    source: app.active_atlas_prefix + 'stroop_match_preview'

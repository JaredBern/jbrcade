                    text: "SPEED"
                    font_name: "assets/fonts/ARCADE_N.TTF"
                    font_size: '16sp'
                    color: (0, 0.75, 1, 1)
                    size_hint_y: None
                    height: dp(20)
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'

                GridLayout:
                    cols: 3
                    spacing: dp(6)
                    size_hint_y: None
                    height: self.minimum_height

                    BoxLayout: # Stroop Match
                        size_hint_y: None
                        height: self.width
